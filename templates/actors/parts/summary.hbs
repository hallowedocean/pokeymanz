<section class="tab summary {{tab.cssClass}}" data-group="primary" data-tab="summary">
    <div class="flex">
        <div class="sidebar-card card flex-col">
            <div class="portrait actor-portrait">
                <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action={{ifThen
                    isPlayMode "renderIP" "editImage" }} alt="{{actor.name}}" title="{{actor.name}}" />
            </div>
            <div class="stat-bar flex">
                <div class="toughtness-container stat-container flex items-center">
                    <i class="stat-icon fa-solid fa-shield"></i>
                    <label class="stat-label">{{localize "POKEYMANZ.Stats.Toughness"}}</label>
                    <input class="stat-input spacing--p-0" type="number" name="system.stats.toughness.value"
                        value="{{system.stats.toughness.value}}" {{disabled isPlayMode }}>
                </div>
                <div class="wounds-container stat-container flex items-center">
                    <i class="stat-icon fa-solid fa-heart"></i>
                    <label class="stat-label">{{localize "POKEYMANZ.Stats.Wounds"}}</label>
                    <div class="wound-input-container flex">
                        <a data-action="adjustStat" data-sub-action="wounds-minus"><i class="adjust-icon fa-regular fa-square-minus"></i></a>
                        <input class="stat-input spacing--p-0" type="number" name="system.stats.wounds.value"
                            value="{{system.stats.wounds.value}}" {{disabled isPlayMode }}>
                        <span>/</span>
                        <input class="stat-input stat-max spacing--p-0" type="number" name="system.stats.wounds.max"
                            value="{{system.stats.wounds.max}}" {{disabled isPlayMode }}>
                        <a data-action="adjustStat" data-sub-action="wounds-plus"><i class="adjust-icon fa-regular fa-square-plus"></i></a>
                    </div>
                </div>
                {{#if (eq actor.type "pokemon")}}
                    {{#if system.flags.isShadow.value}}
                    <div class="fury-container stat-container flex items-center">
                        <i class="stat-icon fa-solid fa-cloud-bolt"></i>
                        <label class="stat-label">{{localize "POKEYMANZ.Stats.Fury"}}</label>
                        <div class="fury-input-container flex">
                            <input class="stat-input spacing--p-0" type="number" name="system.stats.fury.value"
                                value="{{system.stats.fury.value}}" {{disabled isPlayMode }}>
                            <span>/</span>
                            <input class="stat-input stat-max spacing--p-0" type="number" name="system.stats.fury.max"
                            value="{{system.stats.fury.max}}" {{disabled isPlayMode }}>
                        </div>
                    </div>
                    {{else}}
                    <div class="mastery-container stat-container flex items-center">
                        <i class="stat-icon fa-solid fa-crown"></i>
                        <label class="stat-label">{{localize "POKEYMANZ.Stats.Mastery"}}</label>
                        <div class="mastery-input-container flex">
                            <a data-action="adjustStat" data-sub-action="mastery-minus"><i class="adjust-icon fa-regular fa-square-minus"></i></a>
                            <input class="stat-input spacing--p-0" type="number" name="system.stats.mastery.value"
                                value="{{system.stats.mastery.value}}" min="0" {{disabled isPlayMode }}>
                            <span>/</span>
                            <input class="stat-input stat-max spacing--p-0" type="number" name="system.stats.mastery.max"
                            value="{{system.stats.mastery.max}}" {{disabled isPlayMode }}>
                            <a data-action="adjustStat" data-sub-action="mastery-plus"><i class="adjust-icon fa-regular fa-square-plus"></i></a>
                        </div>
                    </div>
                    {{/if}}
                {{/if}}
            </div>
            <div class="types-container flex">
                {{#if isPlayMode}}
                {{#if pokemonType.primary.value}}
                <div class="type-badge flex items-center size--medium"
                    style="--type-color: {{pokemonType.primary.color}}">
                    <img src="{{pokemonType.primary.img}}" alt="{{pokemonType.primary.id}}">
                    <span>{{localize pokemonType.primary.name}}</span>
                </div>
                {{/if}}
                {{#if pokemonType.secondary.value}}
                <div class="type-badge flex items-center size--medium"
                    style="--type-color: {{pokemonType.secondary.color}}">
                    <img src="{{pokemonType.secondary.img}}" alt="{{pokemonType.secondary.id}}">
                    <span>{{localize pokemonType.secondary.name}}</span>
                </div>
                {{/if}}
                {{else}}
                <div class="type-select-container">
                    {{formInput pokemonType.primary.field
                    value=pokemonType.primary.value
                    localize=true}}
                </div>
                <div class="type-select-container">
                    {{formInput pokemonType.secondary.field
                    value=pokemonType.secondary.value
                    localize=true}}
                </div>
                {{/if}}
            </div>
            {{#if actor.haveAttributes}}
            {{> pokeymanz.attributes-container isPlayMode=isPlayMode attributes=attributes }}
            {{/if}}
            {{#if (eq actor.type "pokemon")}}
                <div class="trainer-fields-container flex flex-col">
                    {{#if actor.haveTrainer}}
                        {{#if (not isPlayMode)}}
                            <div class="input-group flex items-center">
                                <label class="input-group-label">{{localize "TYPES.Actor.trainer"}}</label>
                                {{formInput trainer.field
                                value=trainer.value
                                classes="input-group-field"
                                }}
                            </div>
                        {{/if}}
                        {{#if (and trainer.value isPlayMode)}}
                            <div class="tainer-container flex flex-col">
                                <div class="trainer-portrait flex">
                                    <img class="trainer-sheet" src="{{actor.system.trainer.value.img}}"
                                        alt="{{actor.system.trainer.value.name}}" data-action="openTrainerSheet">
                                </div>
                                <div class="edit-switch-contianer flex items-center">
                                    <i class="switch-icon fa-solid fa-backpack {{ ifThen trainer.inTeam 'active' '' }}"></i>
                                    <a class="switch-btn" data-action="toggleTrainerTeam">
                                        <i class="fa-solid fa-toggle-{{ifThen trainer.inTeam 'off' 'on' }}"></i>
                                    </a>
                                    <i class="switch-icon fa-solid fa-computer-classic {{ifThen trainer.inTeam '' 'active' }}"></i>
                                </div>
                            </div>
                        {{/if}}
                    {{/if}}
                </div>
                {{#if (and isGM (not isPlayMode))}}
                <div class="options-container">
                    <hr>
                    <h6 class="options-header">{{localize "POKEYMANZ.Options"}}</h6>
                    {{#each system.flags as |flag|}}
                    <input type="checkbox" name="system.flags.{{@key}}.value" {{checked flag.value}} />
                    <label>{{localize flag.label}}?</label><br>
                    {{/each}}
                </div>
                {{/if}}
            {{/if}}
        </div>
        <div class="body-container gap-sm flex flex-col">
            <div class="name-container flex flex-row items-center">
                <input class="document-name" name="name" type="text" value="{{actor.name}}" data-tooltip="{{actor.name}}"
                {{disabled isPlayMode }} />
                {{#if (eq actor.type "pokemon")}}
                    {{#each system.flags as |flag|}}
                        {{#if flag.value}}
                        <img class="flag-icon" src="{{flag.img}}" data-tooltip="{{localize flag.label}}">
                        {{/if}}
                    {{/each}}
                {{/if}}
            </div>
            <div class="flex details-container gap-sm">
                {{#each detailsFields as |field|}}
                <div class="input-group flex items-center size--{{field.size}}" data-tooltip="{{field.value}}">
                    <label class="input-group-label">{{field.label}}</label>
                    <input class="input-group-field" type="{{field.type}}" name="{{field.name}}" value="{{field.value}}"
                        {{disabled ../isPlayMode }}>
                </div>
                {{/each}}
            </div>
            {{#if (eq actor.type "trainer")}}
            {{else}}
            {{> pokeymanz.ability-container isPlayMode=isPlayMode}}
            {{/if}}
            {{#if moves}}
            <div class="move-list gap-md flex flex-col">
                {{#each moves as |move|}}
                {{#if move}}
                <div class="move-container flex">
                    <div class="move-portrait flex">
                        <div class="drag-line draggable" data-doc-id="{{move._id}}" data-document-class="Item">
                            <i></i>
                        </div>
                        <div class="img-portrait" data-action="useItem" data-item-uuid="{{move.uuid}}"
                            data-tooltip="{{localize 'POKEYMANZ.Item.UseItem' item=move.name}}">
                            <img class="move-icon" src="{{move.img}}" alt="{{move.name}}">
                            <img class="roll-icon" src="icons/svg/d20-black.svg" alt="roll-dice">
                        </div>
                    </div>
                    <div class="move-accordion" data-action="toggleExpand">
                        <div class="move-header flex">
                            <div class="move-name">
                                {{move.name}}
                            </div>
                            {{#each system.flags as |flag|}}
                                {{#if flag.value}}
                                <i class="{{flag.icon}} move-flag-icon" data-tooltip="{{localize flag.label}}"></i>
                                {{/if}}
                            {{/each}}
                            <div class="move-type">
                                <div class="type-badge flex size--medium" style="--type-color: {{move.moveType.color}}">
                                    <img src="{{move.moveType.img}}" alt="{{move.moveType.id}}">
                                    <span>{{localize
                                        move.moveType.name}}</span>
                                </div>
                            </div>
                            <div class="move-icons-container flex">
                            <div class="move-dice-container flex">
                                <i class="glyphter-icon-d{{move.system.roll.faces}}" data-tooltip="d{{move.system.roll.faces}}"></i>
                                {{#if move.system.roll.modifier}}
                                <span class="move-dice-modifier">{{numberFormat move.system.roll.modifier sign=true}}</span>
                                {{/if}}
                            </div>
                            <a class="move-menu fix-context-menu aling--right" data-item-uuid="{{move.uuid}}">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </a></div>
                        </div>
                        <div class="move-content">
                            <div class="description-content">
                                {{{move.enrichDescription}}}
                            </div>
                            <hr>
                            <div class="move-type-matchups">
                                <h6 class="move-type-matchups-header">{{localize "POKEYMANZ.TypeMatchups.Label"}}</h6>
                                {{#if move.moveType.superEffectiveAgainst}}<span class="move-type-matchup-label">{{localize "POKEYMANZ.TypeMatchups.Weaknesses"}} {{localize "POKEYMANZ.TypeMatchups.Against"}}:</span> {{#each move.moveType.superEffectiveAgainst as |type|}}{{type}}{{#unless @last}}, {{/unless}}{{/each}}<br>{{/if}}
                                {{#if move.moveType.neutralDamageAgainst}}<span class="move-type-matchup-label">{{localize "POKEYMANZ.TypeMatchups.NormalDamage"}} {{localize "POKEYMANZ.TypeMatchups.Against"}}:</span> {{#each move.moveType.neutralDamageAgainst as |type|}}{{type}}{{#unless @last}}, {{/unless}}{{/each}}<br>{{/if}}
                                {{#if move.moveType.notVeryEffectiveAgainst}}<span class="move-type-matchup-label">{{localize "POKEYMANZ.TypeMatchups.Resistances"}} {{localize "POKEYMANZ.TypeMatchups.Against"}}:</span> {{#each move.moveType.notVeryEffectiveAgainst as |type|}}{{type}}{{#unless @last}}, {{/unless}}{{/each}}<br>{{/if}}
                                {{#if move.moveType.noEffectAgainst}}<span class="move-type-matchup-label">{{localize "POKEYMANZ.TypeMatchups.Immunities"}} {{localize "POKEYMANZ.TypeMatchups.Against"}}:</span> {{#each move.moveType.noEffectAgainst as |type|}}{{type}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}
                            </div>
                        </div>
                    </div>
                </div>
                {{else}}
                <div class="move-container empty-move flex justify-center" data-action="createDoc"
                    data-document-class="Item" data-type="move" data-tooltip="{{localize 'DOCUMENT.New' type=" Move"
                    }}">
                    <i class="create-doc-icon fa-solid fa-square-plus"></i>
                </div>
                {{/if}}
                {{/each}}
            </div>
            {{/if}}

            {{#if pokemons}}
            <div class="pokemon-list gap-md flex flex-col">
                {{#each pokemons.team as |pokemon|}}
                <div class="info-card pokemon-card flex">
                    <div class="portrait-contianer">
                        <img src="{{pokemon.img}}" alt="{{pokemon.name}}">
                    </div>
                    <div class="card-containter">
                        <div class="title-container flex">
                            <span>
                                {{pokemon.name}}
                            </span>
                            <div class="types-icons flex">
                                {{#if pokemon.system.stats.pokemonTypes.primary.value}}
                                <img style="--type-color: {{pokemon.system.stats.pokemonTypes.primary.color}};"
                                    src="{{pokemon.system.stats.pokemonTypes.primary.img}}"
                                    data-tooltip="{{localize pokemon.system.stats.pokemonTypes.primary.name}}"
                                    alt="{{localize pokemon.system.stats.pokemonTypes.primary.name}}">

                                {{/if}}
                                {{#if pokemon.system.stats.pokemonTypes.secondary.value}}
                                <img style="--type-color: {{pokemon.system.stats.pokemonTypes.secondary.color}};"
                                    src="{{pokemon.system.stats.pokemonTypes.secondary.img}}"
                                    data-tooltip="{{localize pokemon.system.stats.pokemonTypes.secondary.name}}"
                                    alt="{{localize pokemon.system.stats.pokemonTypes.secondary.name}}">
                                {{/if}}
                            </div>
                            <div class="controls">
                                <a class="pokemon-menu fix-context-menu aling--right" data-actor-uuid="{{pokemon.uuid}}">
                                    <i class="fa-solid fa-ellipsis-vertical"></i>
                                </a>
                            </div>
                        </div>
                        <div class="card-content grid grid-rows-2">
                            {{#each pokemon.itemTypes.move as |move|}}
                            <a class="move-button flex items-center"
                                style="--type-color: {{move.moveType.color}};" data-action="useItem"
                                data-item-uuid="{{move.uuid}}">
                                <img src="{{move.moveType.img}}" alt="{{move.moveType.id}}"
                                    data-tooltip="{{move.moveType.name}}">
                                        <span data-tooltip="{{move.name}}">{{move.name}}</span>
                                        {{#each system.flags as |flag|}}
                                            {{#if flag.value}}
                                            <i class="{{flag.icon}} move-flag-icon" data-tooltip="{{localize flag.label}}"></i>
                                            {{/if}}
                                        {{/each}}
                                <img class="dice-icon" src="{{move.system.roll.diceIcon}}" data-tooltip="{{move.system.roll.formula}}">
                            </a>
                            {{/each}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}
        </div>
    </div>
</section>