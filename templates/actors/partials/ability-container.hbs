<div class="tab effects">
    <ol class="items-list">
        {{#each abilityFields as |section sid|}}
        <li class="ability-container flexrow">
            <div class="item-name flexrow">
                 <label class="input-group-label">{{section.label}}</label>
            </div>
            <div class="item-controls">
                {{#if ../isPlayMode}}
                {{else}}
                <a class="item-control" data-action="createDoc" data-document-class="Item" data-type="ability"
                    data-system-type="{{sid}}" data-tooltip="{{localize 'DOCUMENT.New' type='Ability' }}">
                    <i class="fas fa-plus"></i>
                </a>
                {{/if}}
            </div>
        </li>
        <ol class="item-list spacing--p-0 spacing--m-0">
            {{#if section.items}}
                {{#each section.items as |item|}}
                <li class="ability-name item flexrow" data-doc-id="{{item.id}}" data-document-class="Item" data-drag="true">
                    <div class="item-name flexrow">
                        <img class="item-image" src="{{item.img}}" height="24" width="24" alt="{{item.name}}">
                        <div>{{item.name}}</div>
                    </div>
                    <div class="item-controls flexrow">
                        {{#if ../../isPlayMode}}
                        {{else}}
                        <a class="item-control" data-action="viewDoc" data-tooltip="{{localize 'DOCUMENT.Update'
                            type=item.name }}">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a class="item-control" data-action="deleteDoc" data-tooltip="{{localize 'DOCUMENT.Delete'
                            type=item.name }}">
                            <i class="fas fa-trash"></i>
                        </a>
                        {{/if}}
                    </div>
                </li>
                <li class="ability-item flexrow" data-doc-id="{{item.id}}" data-document-class="Item" data-drag="true">
                    <div class="ability-desc item-name flexrow">
                        {{{item.system.notes.description}}}
                    </div>
                </li>
                {{/each}}
            {{else}}
                <li class="ability-item flexrow">
                    <div class="ability-desc item-name flexrow">
                        <p></p>
                    </div>
                </li>
            {{/if}}
        </ol>
        {{/each}}
    </ol>
</div>